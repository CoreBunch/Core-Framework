{
	"name": "@core-framework/monorepo",
	"private": true,
	"description": "A visual CSS framework and design-token builder for the web, WordPress, and Figma.",
	"author": "David Babinec",
	"license": "MIT",
	"packageManager": "bun@1.3.11",
	"engines": {
		"bun": ">=1.3.0 <1.4.0"
	},
	"homepage": "https://coreframework.com/",
	"repository": {
		"type": "git",
		"url": "https://github.com/corebunch/core-framework.git"
	},
	"bugs": {
		"url": "https://github.com/corebunch/core-framework/issues"
	},
	"workspaces": ["packages/*"],
	"overrides": {
		"adm-zip": "0.6.0",
		"@babel/core": "7.29.7",
		"@babel/plugin-transform-modules-systemjs": "7.29.8",
		"basic-ftp": "5.3.1",
		"copy-webpack-plugin": "14.0.0",
		"fast-uri": "3.1.5",
		"flatted": "3.4.4",
		"follow-redirects": "1.16.0",
		"http-proxy-middleware": "2.0.10",
		"ip-address": "10.5.0",
		"js-yaml": "4.3.1",
		"lodash-es": "4.18.1",
		"markdown-it": "15.0.0",
		"markdownlint-cli": "0.48.0",
		"micromatch": "4.0.8",
		"nanoid": "3.3.18",
		"postcss": "8.5.26",
		"svgo": "3.3.4",
		"websocket-driver": "0.7.5",
		"yaml": "1.10.3"
	},
	"scripts": {
		"preinstall": "npx -y only-allow bun",
		"lint": "bun run --filter './packages/www' lint && bun run --filter './packages/wp' lint",
		"format": "sh ./scripts/format.sh",
		"audit:security": "bun audit --audit-level=high --ignore=GHSA-jmr9-qjv8-65gv",
		"check:open-source": "bun run scripts/check-open-source-boundaries.ts",
		"fonts:refresh": "bun run scripts/build-google-fonts.ts",
		"bump": "bun run scripts/version-change.ts",
		"version": "bun run scripts/version.ts",
		"release": "bun run scripts/release.ts",
		"release:figma": "bun run scripts/build-figma-release.ts",
		"release:wp": "bun run scripts/build-wp-release.ts",
		"e2e:wp": "bun run release:wp && bash scripts/test-wp-e2e.sh",
		"prepare": "husky",
		"dev:www": "bun run --filter './packages/www' dev",
		"build:www": "bun run --filter './packages/www' build",
		"test:www": "bun run --filter './packages/www' test",
		"dev:wp": "bun run build:builders && bun run --filter './packages/wp' dev",
		"build:wp": "bun run --filter './packages/wp' build",
		"export:wp": "bun run release:wp",
		"php-format:wp": "bun run --filter './packages/wp' php-format",
		"php-test:wp": "bun run --filter './packages/wp' php-test",
		"build:gutenberg": "bun run --filter './packages/gutenberg' build",
		"build:builders": "bun run --filter './packages/builder-integrations' build",
		"dev:blocks": "bun run --filter './packages/blocks' dev",
		"build:blocks": "bun run --filter './packages/blocks' build",
		"update": "bun update",
		"dev:figma": "bun run --filter './packages/figma' dev",
		"build:figma": "bun run --filter './packages/figma' build"
	},
	"devDependencies": {
		"@jest/globals": "^30.4.1",
		"@types/jest": "^30.0.0",
		"husky": "^9.1.7",
		"jest": "^30.4.2",
		"ts-jest": "^29.4.12"
	}
}
