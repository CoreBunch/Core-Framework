{
	"compilerOptions": {
		"target": "es2017",
		"module": "commonjs",
		"esModuleInterop": true,
		"forceConsistentCasingInFileNames": true,
		"noUncheckedIndexedAccess": true,
		"strict": true,
		"skipLibCheck": true,
		"noEmitOnError": true,
		"sourceMap": false,
		"outDir": "../wp/assets/public/js"
	},
	"include": ["src/**/*"]
}
