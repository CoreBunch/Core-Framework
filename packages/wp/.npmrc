auto-install-peers = true
strict-peer-dependencies = false

hoist-pattern[] = *prettier*
hoist-pattern[] = *framework-utils*
hoist-pattern[] = *@daybrush/utils*
hoist-pattern[] = *postcss-scss*
hoist-pattern[] = events
hoist-pattern[] = buffer
hoist-pattern[] = *emotion*
hoist-pattern[] = *vite*

public-hoist-pattern[] = *prettier*
public-hoist-pattern[] = *@babel*
public-hoist-pattern[] = *react*
public-hoist-pattern[] = *emotion*
public-hoist-pattern[] = *mantine*

