{
	"name": "coreframework",
	"version": "2.0.0",
	"description": "The Core Framework WordPress plugin.",
	"author": "David Babinec",
	"license": "MIT",
	"repository": {
		"type": "git",
		"url": "https://github.com/corebunch/core-framework.git",
		"directory": "packages/wp"
	},
	"private": true,
	"main": "webpack.common.js",
	"type": "module",
	"prettier": "../../.prettierrc.cjs",
	"scripts": {
		"dev": "bun start",
		"start": "rm -rf dist/** && bun run env:dev && vite",
		"build": "bun run env:prod && tsc && vite build",
		"lint": "biome check --write --unsafe ./src",
		"env:dev": "replace-in-files --string='production' --replacement='development' ./.env",
		"env:prod": "replace-in-files --string='development' --replacement='production' ./.env",
		"unimported": "npx unimported",
		"cu": "bun update --interactive --latest",
		"licence-list": "npx license-checker --summary --production",
		"license-unknown": "npx license-checker --onlyunknown",
		"tsc": "npx -p typescript tsc",
		"composer:dev": "composer install && composer dumpautoload -o",
		"composer:prod": "composer install --no-dev && composer dumpautoload -o",
		"export": "bun run ../../scripts/build-wp-release.ts",
		"php-format": "composer install && composer dumpautoload -o && vendor/bin/phpcbf --colors --standard=WordPress -p wp",
		"php-test": "./vendor/bin/phpunit Tests"
	},
	"devDependencies": {
		"@biomejs/biome": "^2.5.7",
		"@total-typescript/ts-reset": "^0.4.2",
		"@trivago/prettier-plugin-sort-imports": "^6.0.2",
		"@types/fontkit": "^2.0.9",
		"@types/node": "^20.19.43",
		"@types/react": "^18.3.31",
		"@types/react-dom": "^18.3.7",
		"@vitejs/plugin-react-swc": "^4.3.3",
		"dotenv": "^16.0.3",
		"kolorist": "^1.8.0",
		"prettier": "^3.9.6",
		"replace-in-files-cli": "^2.0.0",
		"sass": "^1.102.0",
		"typescript": "^5.9.3",
		"vite": "^6.4.3",
		"vite-plugin-live-reload": "^3.1.0",
		"vite-tsconfig-paths": "^6.1.1"
	},
	"dependencies": {
		"@core-framework/core": "workspace:*",
		"@adobe/react-spectrum": "^3.47.3",
		"@dnd-kit/core": "^6.0.8",
		"@dnd-kit/sortable": "^7.0.2",
		"@dnd-kit/utilities": "^3.2.1",
		"@mantine/core": "^6.0.8",
		"@mantine/hooks": "^6.0.8",
		"clsx": "^1.2.1",
		"colord": "^2.9.3",
		"compare-versions": "^6.1.0",
		"fontkit": "^2.0.4",
		"jotai": "^2.20.2",
		"postcss": "^8.5.26",
		"postcss-preset-env": "^10.6.1",
		"postcss-selector-parser": "^7.1.5",
		"process": "^0.11.10",
		"react": "^18.2.0",
		"react-dom": "^18.2.0",
		"sonner": "^0.3.5",
		"ts-pattern": "^4.3.0",
		"ulid": "^2.3.0",
		"zod": "^3.21.4"
	}
}
