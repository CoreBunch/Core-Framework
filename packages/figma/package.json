{
	"name": "core-framework-figma",
	"version": "2.0.0",
	"private": true,
	"description": "Figma integration for Core Framework",
	"author": "David Babinec",
	"license": "MIT",
	"repository": {
		"type": "git",
		"url": "https://github.com/corebunch/core-framework.git",
		"directory": "packages/figma"
	},
	"scripts": {
		"main": "esbuild main/code.ts --bundle --outfile=dist/code.js",
		"editor": "vite build --config vite.editor.config.ts",
		"editor:watch": "vite build --config vite.editor.config.ts --watch",
		"ui": "tsc && vite build --minify esbuild",
		"build": "bun run editor && concurrently -n main,ui \"bun run main\" \"bun run ui\"",
		"dev": "bun run editor && concurrently -n editor,main,ui \"bun run editor:watch\" \"bun run main -- --watch\" \"bun run ui -- --watch\""
	},
	"dependencies": {
		"@fontsource-variable/inter": "^5.3.0",
		"colord": "^2.9.3",
		"jotai": "^2.20.2",
		"react": "^18.2.0",
		"react-aria-components": "^1.20.0",
		"react-dom": "^18.2.0",
		"ulid": "^2.3.0",
		"zod": "^3.21.4"
	},
	"devDependencies": {
		"@figma/plugin-typings": "^1.132.0",
		"@types/react": "^18.3.31",
		"@types/react-dom": "^18.3.7",
		"@vitejs/plugin-react": "^4.7.0",
		"concurrently": "^10.0.4",
		"esbuild": "^0.28.1",
		"rollup": "^4.62.4",
		"sass": "^1.102.0",
		"typescript": "^5.9.3",
		"vite": "^6.4.3",
		"vite-plugin-singlefile": "^2.3.3"
	}
}
